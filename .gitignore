# ==============================================================================
# X-BLAST — Git ignore
# ==============================================================================

# Bytecode y cache de Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
build/
dist/

# Entornos virtuales
venv/
.venv/
env/
ENV/

# Pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editores e IDE
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.lnk

# Cache de PyVista y registros
pyvista_cache/
*.log

# Salidas generadas (se conserva la carpeta, no su contenido)
reports_output/*
!reports_output/.gitkeep

# Proyectos y exportaciones locales
*.xbp
